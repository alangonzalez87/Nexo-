{
  "name": "nexo-sales",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.20.0"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @nexo/api\" \"npm run dev -w @nexo/web\"",
    "dev:demo": "tsx scripts/demo.ts",
    "dev:local": "tsx --env-file-if-exists=.env scripts/demo.ts --integrations",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test --test-concurrency=1 apps/api/test/*.test.ts",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx --env-file-if-exists=.env packages/database/src/seed.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@electric-sql/pglite-socket": "^0.0.22",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
