DATABASE_URL=postgresql://nexo:nexo_local@localhost:5432/nexo?connection_limit=5
POSTGRES_PASSWORD=nexo_local
PORT=3001
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@nexo.local
ADMIN_PASSWORD=replace-with-a-strong-local-password
STORAGE_DIR=.data/private
AI_PROVIDER=rules
# Las claves y habilitación reales se guardan por negocio desde API e integraciones.
# Estas variables de proveedor ya no habilitan automáticamente todos los negocios.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# No real number is connected by default. See docs/openwa.md before enabling.
OPENWA_ENABLED=false
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
# Solo servidor: clave ADMIN de OpenWA para preparar una sesión aislada por negocio.
# No la compartas con los usuarios ni la incluyas en el frontend.
OPENWA_MANAGED_ADMIN_KEY=
OPENWA_WEBHOOK_SECRET=
# Orígenes que un administrador puede configurar como gateway (separados por coma).
# Si se omite, sólo se permite OPENWA_BASE_URL.
OPENWA_ALLOWED_ORIGINS=http://localhost:2785
# Clave estable de cifrado de credenciales. Si se omite, se usa JWT_SECRET.
# Definila ANTES de guardar claves y conservá una copia segura; no la cambies sin migrarlas.
CREDENTIALS_KEY=
